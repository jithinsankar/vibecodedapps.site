---
import { SITE } from '../config';
import Icon from './Icon.astro';

const nav = [
  { href: '/', label: 'Index' },
  { href: '/clones', label: 'Replacements' },
  { href: '/categories', label: 'Sections' },
  { href: '/submit', label: 'Submit' },
  { href: '/about', label: 'About' },
];

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href="/">
      <span class="brand__name">Vibecoded</span><span class="brand__stop" aria-hidden="true">.</span>
    </a>

    <nav class="nav" aria-label="Main">
      {nav.map((item) => (
        <a class="nav__link" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>

    <div class="actions">
      <button class="icon-btn theme-toggle" type="button" data-theme-toggle aria-label="Switch colour theme">
        <Icon name="sun" size={15} class="icon-sun" />
        <Icon name="moon" size={15} class="icon-moon" />
      </button>

      <a class="icon-btn" href={SITE.repo} target="_blank" rel="noopener noreferrer" aria-label="Source code on GitHub">
        <Icon name="github" size={15} />
      </a>

      <a class="btn btn--sm" href="/submit">List an app</a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: 20;
    background: var(--paper);
    border-block-end: 1px solid var(--ink);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--s5);
    min-height: 62px;
  }

  .brand {
    display: inline-flex;
    align-items: baseline;
    text-decoration: none;
    margin-inline-end: auto;
  }

  .brand__name {
    font-family: var(--font-display);
    font-size: 1.32rem;
    font-weight: 620;
    font-variation-settings: 'opsz' 40, 'SOFT' 0, 'WONK' 1;
    letter-spacing: -0.02em;
  }

  .brand__stop {
    color: var(--accent);
    font-family: var(--font-display);
    font-size: 1.32rem;
    font-weight: 700;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: var(--s5);
  }

  .nav__link {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--ink-3);
    text-decoration: none;
  }

  .nav__link:hover {
    color: var(--accent);
  }

  .nav__link[aria-current='page'] {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.45em;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: var(--s2);
  }

  .icon-btn {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 1px solid transparent;
    border-radius: var(--r);
    background: transparent;
    color: var(--ink-2);
    cursor: pointer;
    text-decoration: none;
    transition: border-color 0.14s var(--ease), color 0.14s var(--ease);
  }

  .icon-btn:hover {
    border-color: var(--rule-strong);
    color: var(--ink);
  }

  /* The icons live in the Icon component, so they need :global() to match. */
  .theme-toggle :global(.icon-moon) {
    display: none;
  }

  :global(:root[data-theme='dark']) .theme-toggle :global(.icon-sun) {
    display: none;
  }

  :global(:root[data-theme='dark']) .theme-toggle :global(.icon-moon) {
    display: block;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .theme-toggle :global(.icon-sun) {
      display: none;
    }
    :global(:root:not([data-theme='light'])) .theme-toggle :global(.icon-moon) {
      display: block;
    }
  }

  /* Shed the least important links first; Index and Replacements always stay. */
  @media (max-width: 1060px) {
    .site-header__inner {
      gap: var(--s4);
    }
    .nav {
      gap: var(--s3);
    }
    .nav__link[href='/about'] {
      display: none;
    }
  }

  @media (max-width: 820px) {
    .nav__link[href='/categories'] {
      display: none;
    }
  }

  @media (max-width: 620px) {
    /*
     * Two rows: wordmark and controls up top, the directory links beneath.
     * Letting the nav wrap rather than dropping links keeps everything reachable,
     * and means Submit can stay in the header at this size, whereas before it
     * was hidden here and the header simply overflowed the viewport anyway.
     */
    .site-header__inner {
      flex-wrap: wrap;
      row-gap: 0;
    }

    .actions {
      order: 2;
    }

    .nav {
      order: 3;
      width: 100%;
      flex-wrap: wrap;
      gap: var(--s2) var(--s4);
      padding-block: var(--s2);
      border-block-start: 1px solid var(--rule-soft);
    }

    .actions :global(.btn) {
      display: none;
    }
  }
</style>

<script>
  const root = document.documentElement;
  const media = window.matchMedia('(prefers-color-scheme: dark)');

  document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((button) => {
    button.addEventListener('click', () => {
      const current = root.dataset.theme ?? (media.matches ? 'dark' : 'light');
      const next = current === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {
        /* private mode: the theme just will not persist */
      }
    });
  });
</script>
