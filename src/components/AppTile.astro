---
/**
 * Monogram tile: the printed stamp used when a listing has no icon.
 */
interface Props {
  name: string;
  initials: string;
  icon?: string;
  size?: 'sm' | 'md' | 'lg';
}

const { name, initials, icon, size = 'md' } = Astro.props;
const sizeClass = size === 'lg' ? 'tile--lg' : size === 'sm' ? 'tile--sm' : '';
---

<span class={`tile ${sizeClass}`} title={name} aria-hidden="true">
  {icon ? <img src={icon} alt="" width="64" height="64" loading="lazy" decoding="async" /> : initials}
</span>
