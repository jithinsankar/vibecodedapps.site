---
import AdSlot from '../components/AdSlot.astro';
import AppCard from '../components/AppCard.astro';
import AppRow from '../components/AppRow.astro';
import Icon from '../components/Icon.astro';
import ReplacementFinder from '../components/ReplacementFinder.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { PAGE_SIZE, SITE, SPONSORSHIP } from '../config';
import {
  categoriesWithCounts,
  getApps,
  getSpotlight,
  getStats,
  productsWithCounts,
  sortApps,
  toolsWithCounts,
} from '../lib/apps';

const apps = await getApps();
const spotlight = getSpotlight(apps).slice(0, 3);
const stats = getStats(apps);
const categories = categoriesWithCounts(apps);
const tools = toolsWithCounts(apps);
const products = productsWithCounts(apps);

const gaps = products.filter((product) => product.count === 0);

// Spotlight entries are lifted out of the index so nothing appears twice.
const spotlightSlugs = new Set(spotlight.map((app) => app.slug));
const directory = sortApps(
  apps.filter((app) => !spotlightSlugs.has(app.slug)),
  'newest',
);

const pad = (value: number) => String(value).padStart(3, '0');

const editorsNote = SPONSORSHIP.enabled
  ? 'Paid placements are labelled'
  : 'Editor’s picks, no paid placements yet';
---

<BaseLayout>
  <div class="container" data-directory data-page-size={PAGE_SIZE}>
    <!-- Masthead ------------------------------------------------------------ -->
    <section class="hero">
      <p class="eyebrow ink-soft">
        Open directory · Vol. 1 · {new Date().toLocaleDateString('en-GB', {
          day: '2-digit',
          month: 'short',
          year: 'numeric',
        })}
      </p>

      <ReplacementFinder products={products} />

      <p class="hero__stats mono ink-soft">
        <span>{pad(stats.apps)} listings</span>
        <span aria-hidden="true">/</span>
        <span>{pad(stats.incumbents)} products</span>
        <span aria-hidden="true">/</span>
        <span>{pad(stats.covered)} replaced</span>
        <span aria-hidden="true">/</span>
        <span>{pad(stats.tools)} AI tools</span>
      </p>

      <p class="lede">
        A curated index of apps that were vibecoded, organised by the software they replace. Every
        listing says what it stands in for, what it does differently and what it still cannot do.
      </p>
    </section>

    <!-- Spotlight ----------------------------------------------------------- -->
    {
      spotlight.length > 0 && (
        <section class="section" data-spotlight>
          <div class="head-rule">
            <h2 class="head-rule__title">Spotlight</h2>
            <span class="head-rule__meta">{editorsNote}</span>
          </div>
          <div class="spot-grid">
            {spotlight.map((app) => (
              <AppCard app={app} />
            ))}
          </div>
        </section>
      )
    }

    <AdSlot slot="homeInline" class="section" />

    <!-- The index ----------------------------------------------------------- -->
    <section class="section" id="directory">
      <div class="head-rule">
        <h2 class="head-rule__title">The index</h2>
        <span class="head-rule__meta" role="status" aria-live="polite" data-results>
          {pad(directory.length)} of {pad(apps.length)}
        </span>
      </div>

      <div class="toolbar" data-toolbar>
        <span class="eyebrow toolbar__legend">Filter</span>

        <div class="toolbar__group toolbar__group--grow">
          <label class="label" for="q">Search the index</label>
          <input
            id="q"
            class="input"
            type="search"
            name="q"
            placeholder="Name, tool, tag or product…"
            autocomplete="off"
            spellcheck="false"
            data-search
          />
        </div>

        <div class="toolbar__group">
          <label class="label" for="filter-category">Section</label>
          <select class="select" id="filter-category" data-filter-category>
            <option value="">All sections</option>
            {categories.map((category) => (
              <option value={category.name}>
                {category.name} ({category.count})
              </option>
            ))}
          </select>
        </div>

        <div class="toolbar__group">
          <label class="label" for="filter-tool">Vibecoded with</label>
          <select class="select" id="filter-tool" data-filter-tool>
            <option value="">Any tool</option>
            {tools.map((tool) => (
              <option value={tool.name}>
                {tool.name} ({tool.count})
              </option>
            ))}
          </select>
        </div>

        <div class="toolbar__group">
          <label class="label" for="sort">Order</label>
          <select class="select" id="sort" data-sort>
            <option value="newest">Newest first</option>
            <option value="popular">Most starred</option>
            <option value="az">Alphabetical</option>
          </select>
        </div>

        <button class="btn btn--ghost btn--sm toolbar__reset" type="button" data-reset hidden>
          <Icon name="close" size={12} /> Reset
        </button>
      </div>

      <div class="index">
        <div class="index__head" aria-hidden="true">
          <span>No.</span>
          <span></span>
          <span>App</span>
          <span>Vibecoded with</span>
          <span>Launched</span>
          <span class="index__head-end">Stars</span>
          <span></span>
        </div>

        <div data-list>
          {directory.map((app, index) => (
            <AppRow app={app} index={index} />
          ))}
        </div>
      </div>

      <div class="empty" data-empty hidden>
        <p class="lede">Nothing in the index matches that.</p>
        <p class="small muted">
          Missing something you built? <a href="/submit">Add it to the directory</a>.
        </p>
      </div>

      <div class="more">
        <button class="btn btn--ghost" type="button" data-more hidden>Load the next {PAGE_SIZE}</button>
      </div>
    </section>

    <!-- Tools --------------------------------------------------------------- -->
    <section class="section">
      <div class="head-rule">
        <h2 class="head-rule__title">By tool</h2>
        <span class="head-rule__meta">{tools.length} tools in use</span>
      </div>
      <div class="cluster">
        {tools.map((tool) => (
          <a class="chip" href={`/?tool=${encodeURIComponent(tool.name)}#directory`}>
            {tool.name} <span class="muted numeric">{pad(tool.count)}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- Gaps ---------------------------------------------------------------- -->
    <section class="section">
      <div class="head-rule">
        <h2 class="head-rule__title">Open gaps</h2>
        <span class="head-rule__meta">{gaps.length} products with no replacement</span>
      </div>
      <p class="lede" style="margin-block-end: var(--s5)">
        Nobody in the directory has replaced these yet. Each one has a page explaining what a clone
        would have to get right.
      </p>
      <div class="cluster">
        {
          gaps.slice(0, 14).map((product) => (
            <a class="chip" href={`/clone/${product.slug}`}>
              {product.name} <span class="muted">?</span>
            </a>
          ))
        }
        <a class="chip" href="/clones">
          All {products.length} products <Icon name="arrow-right" size={11} />
        </a>
      </div>
    </section>

    <!-- Contribute ---------------------------------------------------------- -->
    <section class="section band">
      <div class="band__col">
        <span class="eyebrow">Contribute</span>
        <h2>Built something with AI this week?</h2>
        <p class="muted">
          Every listing is one small JSON file in this repository. Add a file, open a pull request,
          and the index rebuilds itself.
        </p>
        <div class="btn-row">
          <a class="btn" href="/submit">Submit an app <Icon name="arrow-right" size={14} /></a>
          <a class="btn btn--ghost" href={SITE.repo} target="_blank" rel="noopener noreferrer">
            <Icon name="github" size={13} /> Star the repo
          </a>
        </div>
      </div>

      {
        SPONSORSHIP.enabled ? (
          <div class="band__col">
            <span class="eyebrow">Sponsorship</span>
            <h2>Get your app in the spotlight</h2>
            <p class="muted">
              Placements are labelled, expire on their own, and never outrank the index.
            </p>
            <a class="btn btn--ghost" href="/sponsor">
              See placement options <Icon name="arrow-right" size={14} />
            </a>
          </div>
        ) : (
          <div class="band__col">
            <span class="eyebrow">Independence</span>
            <h2>No ads. No tracking. No algorithm.</h2>
            <p class="muted">
              MIT-licensed, built as static files, and readable in one sitting. Fork it and run a
              version for your own niche.
            </p>
            <a class="btn btn--ghost" href="/about">
              How it works <Icon name="arrow-right" size={14} />
            </a>
          </div>
        )
      }
    </section>
  </div>
</BaseLayout>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    gap: var(--s4);
    padding-block-end: var(--s6);
  }

  .hero__stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6em;
    font-size: var(--step--2);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--ink-3);
    padding-block-start: var(--s3);
    border-block-start: 1px solid var(--rule);
  }

  .toolbar__group--grow {
    flex: 1 1 240px;
  }

  .toolbar__group--grow :global(.input) {
    width: 100%;
    padding-block: 0.28rem;
    font-size: var(--step--1);
  }

  .spot-grid {
    display: grid;
    gap: var(--s4);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
  }

  .toolbar {
    position: sticky;
    inset-block-start: 62px;
    z-index: 10;
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: var(--s3) var(--s5);
    padding-block: var(--s3);
    margin-block-end: var(--s2);
    background: var(--paper);
    border-block-end: 1px solid var(--rule);
  }

  .toolbar__legend {
    align-self: center;
    color: var(--ink);
  }

  .toolbar__group {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .toolbar__reset {
    margin-inline-start: auto;
  }

  .index__head {
    display: grid;
    grid-template-columns: var(--row-grid);
    column-gap: var(--s4);
    padding: 0 var(--s3) var(--s2) calc(var(--s3) + 9px);
    border-block-end: 1px solid var(--ink);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .index__head-end {
    justify-self: end;
  }

  .empty {
    display: flex;
    flex-direction: column;
    gap: var(--s2);
    align-items: flex-start;
    padding-block: var(--s7);
  }

  .more {
    display: flex;
    justify-content: center;
    margin-block-start: var(--s6);
  }

  .band {
    display: grid;
    gap: 0;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    border: 1px solid var(--ink);
  }

  .band__col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s3);
    padding: var(--s6) var(--s5);
  }

  .band__col + .band__col {
    border-inline-start: 1px solid var(--ink);
  }

  .band__col h2 {
    font-size: var(--step-2);
  }

  .band__col p {
    max-width: 42ch;
  }

  @media (max-width: 900px) {
    .index__head {
      grid-template-columns: 2.25rem 2.5rem minmax(0, 1fr) 30px;
    }
    .index__head span:nth-child(4),
    .index__head span:nth-child(5),
    .index__head span:nth-child(6) {
      display: none;
    }
    .toolbar {
      position: static;
    }
  }

  @media (max-width: 620px) {
    .band__col + .band__col {
      border-inline-start: 0;
      border-block-start: 1px solid var(--ink);
    }
    .toolbar__legend {
      display: none;
    }
    .toolbar__group {
      flex: 1 1 40%;
    }
  }
</style>

<script>
  type Row = HTMLElement & {
    dataset: DOMStringMap & {
      search: string;
      category: string;
      tools: string;
      launched: string;
      stars: string;
      name: string;
    };
  };

  const root = document.querySelector<HTMLElement>('[data-directory]');
  if (root) {
    const rows = [...root.querySelectorAll<Row>('[data-app]')];
    const list = root.querySelector<HTMLElement>('[data-list]')!;
    const searchInput = root.querySelector<HTMLInputElement>('[data-search]')!;
    const categorySelect = root.querySelector<HTMLSelectElement>('[data-filter-category]')!;
    const toolSelect = root.querySelector<HTMLSelectElement>('[data-filter-tool]')!;
    const sortSelect = root.querySelector<HTMLSelectElement>('[data-sort]')!;
    const results = root.querySelector<HTMLElement>('[data-results]')!;
    const empty = root.querySelector<HTMLElement>('[data-empty]')!;
    const spotlight = root.querySelector<HTMLElement>('[data-spotlight]');
    const resetButton = root.querySelector<HTMLButtonElement>('[data-reset]')!;
    const moreButton = root.querySelector<HTMLButtonElement>('[data-more]')!;
    const pageSize = Number(root.dataset.pageSize ?? 12);

    const pad = (value: number) => String(value).padStart(3, '0');

    const params = new URLSearchParams(location.search);
    searchInput.value = params.get('q') ?? '';
    categorySelect.value = params.get('category') ?? '';
    toolSelect.value = params.get('tool') ?? '';
    sortSelect.value = params.get('sort') ?? 'newest';

    let shown = pageSize;
    let debounce: number | undefined;

    const comparators: Record<string, (a: Row, b: Row) => number> = {
      newest: (a, b) => b.dataset.launched.localeCompare(a.dataset.launched),
      popular: (a, b) => Number(b.dataset.stars) - Number(a.dataset.stars),
      az: (a, b) => a.dataset.name.localeCompare(b.dataset.name),
    };

    function syncUrl() {
      const next = new URLSearchParams();
      if (searchInput.value.trim()) next.set('q', searchInput.value.trim());
      if (categorySelect.value) next.set('category', categorySelect.value);
      if (toolSelect.value) next.set('tool', toolSelect.value);
      if (sortSelect.value !== 'newest') next.set('sort', sortSelect.value);
      const query = next.toString();
      history.replaceState(null, '', query ? `?${query}` : location.pathname);
    }

    function apply() {
      const terms = searchInput.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
      const category = categorySelect.value;
      const tool = toolSelect.value;
      const filtering = Boolean(terms.length || category || tool);

      const matches: Row[] = [];

      for (const row of rows) {
        const haystack = row.dataset.search ?? '';
        const okSearch = terms.every((term) => haystack.includes(term));
        const okCategory = !category || row.dataset.category === category;
        const okTool = !tool || (row.dataset.tools ?? '').split('|').includes(tool);
        if (okSearch && okCategory && okTool) matches.push(row);
      }

      matches.sort(comparators[sortSelect.value] ?? comparators.newest!);

      for (let index = 0; index < matches.length; index += 1) {
        const row = matches[index]!;
        row.hidden = index >= shown;
        list.append(row);
      }

      const visible = Math.min(shown, matches.length);
      results.textContent = filtering
        ? `${pad(matches.length)} match · ${pad(visible)} shown`
        : `${pad(visible)} of ${pad(matches.length)}`;

      empty.hidden = matches.length > 0;
      moreButton.hidden = matches.length <= shown;
      resetButton.hidden = !filtering;
      if (spotlight) spotlight.hidden = filtering;
    }

    function reset() {
      searchInput.value = '';
      categorySelect.value = '';
      toolSelect.value = '';
      sortSelect.value = 'newest';
      shown = pageSize;
      syncUrl();
      apply();
    }

    searchInput.addEventListener('input', () => {
      shown = pageSize;
      window.clearTimeout(debounce);
      debounce = window.setTimeout(() => {
        syncUrl();
        apply();
      }, 120);
    });

    for (const control of [categorySelect, toolSelect, sortSelect]) {
      control.addEventListener('change', () => {
        shown = pageSize;
        syncUrl();
        apply();
      });
    }

    resetButton.addEventListener('click', reset);
    moreButton.addEventListener('click', () => {
      shown += pageSize;
      apply();
    });

    // "/" focuses search, the way a good index should.
    document.addEventListener('keydown', (event) => {
      const target = event.target as HTMLElement | null;
      const typing = target?.matches('input, textarea, select, [contenteditable]');
      if (event.key === '/' && !typing) {
        event.preventDefault();
        searchInput.focus();
      }
    });

    apply();
  }
</script>
